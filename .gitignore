# ---- Office temp and lock files ----
# Excel/Word/PowerPoint create these while a file is open
~$*
*.tmp
~*.tmp
*.~*
.~lock.*#

# ---- Mac ----
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# ---- Windows ----
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Cloud sync leftovers ----
.~*
*.icloud
Icon?
.tmp.drivedownload/
.tmp.driveupload/

# ---- Python / Jupyter (if she ever runs analysis in code) ----
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# ---- Secrets: never commit these ----
.env
.env.*
*.key
*.pem
secrets/
credentials*

# ---- Local scratch ----
scratch/
*.bak
*.log
